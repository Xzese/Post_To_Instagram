# Explicit version supported by your Meta application (v26.0 is the SDK default
# reviewed 2026-10-04). This library implements Facebook Login, not Instagram Login.
GRAPH_API_VERSION=v26.0
IG_BUSINESS_USER_ID=
ACCESS_TOKEN=
ACCESS_TOKEN_EXPIRY=
CONTAINER_READY_TIMEOUT=60
CONTAINER_POLL_INTERVAL=2
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# All workers/devices must share this bucket and prefix. Keep operations/ forever;
# deleting its receipts removes the duplicate-publication safeguard.
S3_PREFIX=instagram
# Optional notifications; used only when send_email_alert is explicitly called.
SMTP_SERVER=
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAIL=
